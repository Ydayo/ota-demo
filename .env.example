# 既定値だけでオフラインで動作する(憲法 第8条)。apps/web/.env.local にコピーして使う。

# DB(docker compose の postgres)
DATABASE_URL=postgres://ota:ota@localhost:5432/ota

# メール(docker compose の Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# 疑似サプライヤー API(docker compose の fake-supplier)
SUPPLIER_API_URL=http://localhost:4010

# 決済アダプター: fake(既定。完全オフライン)| stripe(Stripe テストモード)
PAYMENT_PROVIDER=fake

# ログレベル: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
